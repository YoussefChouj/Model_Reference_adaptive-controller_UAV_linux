.agent_contracts/
.agent_patches/
.agent_reports/
.agent_memory/
.agent_scripts/__pycache__/

# Session bookkeeping (orchestrator/knowledge-state marker files; not source)
.agent_state/

# Generated simulation run artifacts (ADR-0006 D7)
sim/runs/

# Graphify AST cache — regenerable, hash-keyed, churns every rebuild
graphify-out/cache/

# CocoIndex vector DB — regenerable via /refresh; blobs exceed GitHub's 100 MB limit
.cocoindex_code/

# Keil build output — regenerated on every uVision build
OBJ/

# Python bytecode
__pycache__/
*.pyc

# Virtual environment
.venv/

# generated livewatch CSVs, meta, and build logs.
# Leading slash matters: a bare `logs/` also matches ground_station/logs/, which holds
# tracked flight telemetry -- new flight logs would be silently ignored.
/logs/

# Flight telemetry: write-once bulk data, archived outside git (see ground_station/logs/README.md).
# Ignore all telemetry by default, then re-include only the runs cited by docs/ADRs/analysis.
# NOTE: these are file globs, not a bare directory -- excluding the directory itself would
# make the '!' re-includes below silently inoperative.
ground_station/logs/*.csv
ground_station/logs/*.png
ground_station/logs/**/*.csv
ground_station/logs/**/*.png

# The manifest of what was archived is itself a .csv -- keep it tracked.
!ground_station/logs/ARCHIVE_MANIFEST.csv

# Cited runs -- keep tracked:
!ground_station/logs/bench/thrust_20260625_000238.csv
!ground_station/logs/flight_1783831067.csv
