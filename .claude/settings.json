{
  "permissions": {
    "allow": [
      "Bash(ccc search*)",
      "Bash(ccc status*)",
      "Bash(python .agent_scripts/knowledge_gate.py*)",
      "Bash(python .agent_scripts/knowledge_state.py*)",
      "Bash(python .agent_scripts/trail.py*)",
      "Bash(python .agent_scripts/path_refresh.py*)",
      "Bash(python .agent_scripts/knowledge_loop.py*)",
      "Bash(python .agent_scripts/install_post_commit.py*)",
      "Bash(python -m ground_station.livewatch*)",
      "Bash(python -m ground_station.flashtool*)",
      "Bash(python C:\\Users\\Acer\\AppData\\Local\\Temp\\claude\\**\\scratchpad\\*.py*)",
      "Read",
      "Write",
      "Bash(*)",
      "PowerShell(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python .agent_scripts/knowledge_gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .agent_scripts/trail.py hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python .agent_scripts/context_watch.py"
          },
          {
            "type": "command",
            "command": "python .agent_scripts/knowledge_loop.py run"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python .agent_scripts/knowledge_loop.py run"
          }
        ]
      }
    ]
  }
}
