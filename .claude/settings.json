{
  "permissions": {
    "allow": [
      "Bash(ccc search*)",
      "Bash(ccc status*)",
      "Bash(python .agent_scripts/knowledge_gate.py*)",
      "Bash(python -m ground_station.livewatch*)",
      "Bash(python -m ground_station.flashtool*)",
      "Bash(python C:\\Users\\Acer\\AppData\\Local\\Temp\\claude\\**\\scratchpad\\*.py*)",
      "Read",
      "Write",
      "Grep",
      "Glob",
      "Bash(*)",
      "PowerShell(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python .agent_scripts/knowledge_gate.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python .agent_scripts/context_watch.py"
          }
        ]
      }
    ]
  }
}
