#!/bin/sh
# Repo-local post-commit hook — fires the self-adaptive knowledge loop after
# every commit. Installed by `python .agent_scripts/install_post_commit.py`.
#
# This hook is fire-and-forget: it kicks off the loop in the background and
# returns immediately so the commit isn't delayed. Failures are logged to
# .agent_state/post_commit_errors.log.

REPO_ROOT="$(git rev-parse --show-toplevel)"
LOG="$REPO_ROOT/.agent_state/post_commit_errors.log"
mkdir -p "$(dirname "$LOG")"

(
  cd "$REPO_ROOT" || exit 0
  python .agent_scripts/knowledge_loop.py run --no-llm >> "$LOG" 2>&1 &
) &

exit 0
