<?xml version="1.0"?>
<!-- no custom C++ plugin — uses gz built-ins only (spec 4c, 2026-08-05). -->
<sdf version="1.9">
  <world name="jx_fly">
    <gravity>0 0 -9.80665</gravity>
    <!-- Default ODE physics (gz-10 default). DART was tried in 2026-08
         bring-up but its contact response is so stiff that even a 30 N
         upward force on a 1.3 kg body produced zero visible motion,
         because the body starts in contact with the ground plane and
         ODE-vs-DART contact normal/friction tuning is non-trivial for
         an airframe whose only contact is at takeoff/landing.
         ODE matches the PX4 reference world and the gz-shipped
         apply_link_wrench demo. -->
    <physics name="ode_1khz" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </visual>
      </link>
    </model>

    <!--
      The runner converts sim/models/jx_fly/jx_fly.urdf to SDF at run
      startup using `gz sdf -p` and writes the result to
      runs/<scenario>/_artifacts/jx_fly_model.sdf. The IMU sensor lives
      inside that SDF (merged at conversion time) so we do NOT redefine
      any links here.  See sim.runner for the conversion path.

      ApplyLinkWrench, PosePublisher, and Imu plugins live INSIDE the
      included jx_fly model (not at the world level) because they
      attach to a model entity. sim/runner.py writes those plugin
      blocks into the model SDF before launching gz sim.
    -->
  </world>
</sdf>